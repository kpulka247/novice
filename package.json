    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "mini-css-extract-plugin": "^2.9.2",
    "playwright": "^1.52.0",
    "semantic-release": "^24.2.3",
    "sharp": "^0.34.1",
    "web-ext": "^8.6.0",
